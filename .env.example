APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# resources/js/utils/echo.ts is the Echo client actually used app-wide
# (payment-confirmation live push in MpesaPaymentModal.tsx / front-end
# Campaigns/Show.tsx) — it's hardcoded to the 'pusher' broadcaster via
# VITE_PUSHER_*, so this must stay 'pusher' to match, or that push silently
# never arrives. (laravel/reverb is installed but currently unused — nothing
# in this app calls @laravel/echo-react's hooks, so configuring it here
# would have no effect on any real feature.)
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_SCHEME=https
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=443

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase Cloud Messaging (see config/firebase.php)
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json

# Rider shift pay rules (see config/rider_shift.php)
RIDER_MAX_HOURS_PER_DAY=7
RIDER_MIN_QUALIFYING_HOURS=3
RIDER_EARLIEST_CHECK_IN_HOUR=6
RIDER_LATEST_CHECK_IN_HOUR=18
RIDER_STATIONARY_SPEED_THRESHOLD_KMH=2
RIDER_STATIONARY_MIN_MINUTES=5

# Web-triggered scheduler for shared hosting, no crontab required (see
# config/scheduling.php). Set to false and add a real crontab entry
# (`* * * * * php artisan schedule:run`) once on a VPS.
SCHEDULER_WEB_CRON_ENABLED=true
SCHEDULER_WEB_CRON_INTERVAL_SECONDS=60
